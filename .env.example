# Server Configuration
PORT=5000

# Database Connection (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nccDB?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SEED_PASSWORD=your_admin_seed_password_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# Email Configuration (Password Reset OTP)
# ==============================================================

# OPTION 1 (RECOMMENDED FOR RENDER FREE): Brevo HTTPS API (Port 443 - Never Blocked)
# Render's free tier blocks outbound SMTP ports 25, 465, & 587.
# Brevo's HTTPS API bypasses Render's firewall completely.
# 1. Sign up at https://www.brevo.com
# 2. Go to SMTP & API -> API Keys -> Generate a new API key (starts with xkeysib-)
# 3. Ensure your sender email is verified in Senders & IP in Brevo.
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_email@gmail.com

# OPTION 2: Brevo SMTP Relay (For Local Dev or environments with open SMTP ports)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=your_brevo_login_email@gmail.com
# MAIL_PASS=xsmtpsib-your_brevo_smtp_key_here
# MAIL_FROM=your_verified_brevo_email@gmail.com

# OPTION 3: Standard Gmail SMTP (Requires Google App Password)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your_email@gmail.com
# MAIL_PASS=your_16_char_google_app_password
# MAIL_FROM=your_email@gmail.com

# OPTION 4: Resend HTTPS API (Port 443)
# RESEND_API_KEY=re_your_resend_api_key_here
