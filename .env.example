# Server Configuration
PORT=5000

# Database Connection (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nccDB?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SEED_PASSWORD=your_admin_seed_password_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=your_email@gmail.com

# Optional Email HTTPS API Fallbacks (Port 443 - for platforms blocking SMTP)
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
